{
  "expo": {
    "name": "Âmi",
    "slug": "ami-app",
    "owner": "marirramalho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amiapp.ami",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.amiapp.ami",
      "adaptiveIcon": {
        "backgroundColor": "#DED4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Âmi usa suas fotos pra importar compromissos da agenda a partir de convites e documentos.",
          "cameraPermission": "A Âmi usa a câmera pra fotografar convites e documentos e importar compromissos da agenda."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F4F8",
          "dark": {
            "backgroundColor": "#1E1A2E"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6074972c-a008-491f-9ca3-c8bd311afef9"
      }
    }
  }
}
